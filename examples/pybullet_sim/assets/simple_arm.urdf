<?xml version="1.0"?>
<robot name="datum_simple_arm">
  <link name="base"><inertial><mass value="1"/><origin xyz="0 0 0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><geometry><cylinder radius="0.12" length="0.12"/></geometry></visual><collision><geometry><cylinder radius="0.12" length="0.12"/></geometry></collision></link>
  <link name="arm"><inertial><mass value="0.4"/><origin xyz="0 0 0.25"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0 0 0.25"/><geometry><box size="0.08 0.08 0.5"/></geometry></visual><collision><origin xyz="0 0 0.25"/><geometry><box size="0.08 0.08 0.5"/></geometry></collision></link>
  <joint name="shoulder" type="revolute"><parent link="base"/><child link="arm"/><origin xyz="0 0 0.06"/><axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="20" velocity="2"/></joint>
</robot>
